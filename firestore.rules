rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 对局：登录的玩家都能读；只有房主能创建；创建后不能修改或删除
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.host == request.auth.uid;
      allow update, delete: if false;

      // 座位：p1 只能由房主创建，p2 谁都可以占（先到先得）
      // 之后只有坐在这个座位上的玩家能更新自己的行动记录
      match /seats/{seat} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && seat in ['p1', 'p2']
                      && request.resource.data.uid == request.auth.uid
                      && (seat != 'p1'
                          || get(/databases/$(database)/documents/games/$(code)).data.host == request.auth.uid);
        allow update: if request.auth != null
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if false;
      }
    }

    // 每位玩家暗中提交的广告分配，只有本人能读写
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
